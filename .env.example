# Database Credentials
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=pragati_nursery
MYSQL_USER=pragati_user
MYSQL_PASSWORD=your_mysql_password_here

# Backend Environment Settings
PORT=8080
DB_URL=jdbc:mysql://mysql-db:3306/pragati_nursery?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=pragati_user
DB_PASSWORD=your_mysql_password_here

# JWT Configuration (No committed defaults)
JWT_SECRET=your_jwt_signing_secret_here
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Razorpay Integration (No committed defaults)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# CORS Allowed Origin
CORS_ALLOWED_ORIGINS=http://localhost:3000
